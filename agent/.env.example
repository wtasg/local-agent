# OpenAI-compatible local LLM endpoint
LLM_BASE_URL=http://localhost:8101
LLM_MODEL=unsloth/Qwen3.5-9B-GGUF:Q4_K_M
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=128

# Optional compatibility aliases (used when LLM_* are unset)
# LOCAL_LLAMA_SERVER_URL=http://localhost:8101
# LOCAL_LLAMA_SERVER_MODEL_NAME=unsloth/Qwen3.5-9B-GGUF:Q4_K_M

# Agent runtime settings
AGENT_VERBOSE=false
AGENT_MAX_ITERATIONS=20
AGENT_MAX_MESSAGES=40
AGENT_MAX_TOKENS=8000
AGENT_ALLOW_SHELL=true
AGENT_CONFIRM_DESTRUCTIVE=true
AGENT_ALLOWED_PATHS=.

# Logging
LOG_LEVEL=info
